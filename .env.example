# Railway Postgres connection string: Postgres service -> Variables -> DATABASE_URL
# (use the "public" connection string if this app isn't deployed inside the
# same Railway project/network as the database)
DATABASE_URL=postgresql://user:password@host:port/railway

# Password to log into /admin, and a random secret used to sign the admin
# session cookie. Generate a secret with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
